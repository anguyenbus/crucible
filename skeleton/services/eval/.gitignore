# Migration-rehearsal generated contents.
#
# scripts/rehearse_migration.sh copies crucible's kernel/, service children, and
# contracts into app/ (with imports rewritten) and the mirrored test subset into
# tests/. Those generated/copied artifacts are intentionally NOT committed -- only
# the skeleton scaffold (pyproject.toml, uv.lock, app/__init__.py, tests/.gitkeep)
# is tracked. Regenerate locally with: bash scripts/rehearse_migration.sh

# Generated app/ packages (copied from crucible, imports rewritten to app.*)
/app/kernel/
/app/deepeval/
/app/phoenix/
/app/datasets/
/app/metrics/
/app/runners/
/app/config.py
/app/contracts/

# Copied test subset + the phoenix_integration auto-skip conftest
/tests/kernel/
/tests/service/
/tests/conftest.py

# Skeleton venv built by `uv sync --frozen` during the rehearsal
/.venv/

# Python caches
__pycache__/
*.pyc
