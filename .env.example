# ============================================================================
# Crucible environment configuration (EXAMPLE)
# ============================================================================
# Copy this file to `.env` and fill in values for your environment:
#
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) — never commit real credentials.
# Crucible loads `.env` automatically via python-dotenv.
#
# Precedence for provider/model/region settings is: env > eval_config.yaml.
# ============================================================================


# ----------------------------------------------------------------------------
# Bedrock model IDs: inference profiles vs. bare on-demand IDs
# ----------------------------------------------------------------------------
# PRODUCTION TARGET — AU-geographic inference profiles (au.*) keep Australian
# legal/PII data in-country (Sydney/Melbourne/Auckland). Do NOT use apac.*
# (broad APAC routing is a residency regression) or global.* (routes worldwide).
# These are the code defaults (au.anthropic.claude-sonnet-4-6 / -opus-4-6).
#
# SCP-RESTRICTED ACCOUNTS — some orgs block Bedrock inference profiles via an
# SCP; every au.*/apac.*/global.* ID then returns AccessDenied. In that case use
# BARE on-demand model IDs (anthropic.claude-...) pinned to an AU region. A bare
# ID is single-region: in ap-southeast-2 it stays in Sydney, so residency still
# holds — you only lose cross-region failover.
#
# Discover what an account is actually granted (bare IDs that return GRANTED):
#     uv run --extra bedrock crucible check bedrock
# or probe candidate IDs with a 1-token boto3 invoke_model and watch for
# AccessDenied vs GRANTED.


# ----------------------------------------------------------------------------
# RAG GENERATOR (Bedrock by default)
# ----------------------------------------------------------------------------
# Provider: "bedrock" (default) or "openai".
CRUCIBLE_GENERATOR_PROVIDER=bedrock
# Production target (inference profile):
CRUCIBLE_GENERATOR_MODEL=au.anthropic.claude-sonnet-4-6
# SCP-restricted account (bare on-demand ID) — uncomment instead:
# CRUCIBLE_GENERATOR_MODEL=anthropic.claude-3-haiku-20240307-v1:0


# ----------------------------------------------------------------------------
# DEEPEVAL JUDGE (Bedrock by default; GLOBAL across all datasets)
# ----------------------------------------------------------------------------
# The judge is the measuring instrument, so these vars are GLOBAL — they apply
# to every dataset slice. The judge model MUST differ from the generator model
# (no same-model self-grading; a startup check rejects judge == generator).
CRUCIBLE_JUDGE_PROVIDER=bedrock
# Production target (inference profile):
CRUCIBLE_JUDGE_MODEL=au.anthropic.claude-opus-4-6
# SCP-restricted account (bare on-demand ID) — uncomment instead. Use the
# strongest model you're granted; here Sonnet 3.5 v2 judges the Haiku generator:
# CRUCIBLE_JUDGE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0


# ----------------------------------------------------------------------------
# AWS (credential chain only — NO access keys here)
# ----------------------------------------------------------------------------
# Bedrock uses the standard AWS credential chain. Set the region (it MUST match
# your inference-profile geography, e.g. ap-southeast-2 for au.* profiles) and,
# optionally, a named profile. The credential chain handles the rest — do NOT
# put aws_access_key_id / aws_secret_access_key here.
AWS_REGION=ap-southeast-2
# AWS_PROFILE=your-profile-name


# ----------------------------------------------------------------------------
# OpenAI / GPT opt-in (for local testing without AWS access)
# ----------------------------------------------------------------------------
# To run against OpenAI instead of Bedrock, set OPENAI_API_KEY and flip the
# provider + model overrides below. Explicit provider WINS, and a provider/model
# mismatch fails loud (e.g. provider=openai with an au.* model is rejected).
# OPENAI_API_KEY=sk-...
# CRUCIBLE_GENERATOR_PROVIDER=openai
# CRUCIBLE_GENERATOR_MODEL=gpt-4o-mini
# CRUCIBLE_JUDGE_PROVIDER=openai
# CRUCIBLE_JUDGE_MODEL=gpt-4o


# ----------------------------------------------------------------------------
# Datasets & observability
# ----------------------------------------------------------------------------
# HuggingFace token for downloading benchmark datasets.
# HF_TOKEN=hf_...

# Phoenix tracing endpoint (only needed when running with --enable-phoenix).
# PHOENIX_ENDPOINT=http://localhost:6006

# Max concurrent DeepEval judge calls (tune to your Bedrock service quota).
DEEPEVAL_MAX_CONCURRENT=10


# ----------------------------------------------------------------------------
# Telemetry (ENFORCED in code — informational only)
# ----------------------------------------------------------------------------
# DEEPEVAL_TELEMETRY_OPT_OUT is force-set to "YES" in code
# (src/crucible/metrics/deepeval_config.py) to disable DeepEval telemetry.
# It is NOT user-tunable — setting it here has no effect; listed for awareness.
# DEEPEVAL_TELEMETRY_OPT_OUT=YES
