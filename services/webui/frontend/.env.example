# Document Analyser — environment.

# --- Server-side only (NEVER prefixed NEXT_PUBLIC_) --------------------------
# Base URL of the orchestrator. Read ONLY inside the Next.js route-handler proxy
# (src/lib/serverEnv.ts). The browser never sees this and never talks to the
# orchestrator directly — that is the dependency firewall. No trailing slash.
ORCHESTRATOR_URL=http://localhost:8000

# --- Client-readable config pin ---------------------------------------------
# The pinned pipeline config reference sent on every /query/stream request.
# This is a non-secret config IDENTIFIER (not an address), so it may reach the
# browser. Optional — defaults to legal-rag-default-1.8.0 when unset. There is
# NO in-UI picker; the provenance line shows the LIVE ref returned in `final`.
#   1.8.0  nemo-all, buffered final, requires the guardrail pod (default)
#   1.4.0  in-house output guard, buffered final, no pod
#   1.2.0  live token streaming (the only streaming mode)
# NEXT_PUBLIC_WEBUI_CONFIG_REF=legal-rag-default-1.8.0

# --- webui BFF (Phase 2: projects / upload / documents) ---------------------
# Base URL of the webui BFF, reached browser-DIRECT (the BFF has its own CORS,
# unlike the orchestrator). This is a non-secret address that reaches the client
# bundle by design. Optional — defaults to http://localhost:8002 when unset.
# Chat is UNCHANGED and does NOT go through the BFF (two-backend topology).
NEXT_PUBLIC_BFF_URL=http://localhost:8002
