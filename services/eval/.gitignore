# services/eval is crucible's single migration scaffold AND the on-demand rehearsal
# target. Only the scaffold is committed -- the generated app/ packages and the
# mirrored test subset are NOT tracked; they are reproduced from src/crucible by
# scripts/rehearse_migration.sh. Regenerate locally with:
#   bash scripts/rehearse_migration.sh
#
# Tracked scaffold: pyproject.toml, uv.lock, app/__init__.py, scripts/, this file.

# Generated app/ packages (copied from crucible/src, imports rewritten to app.*)
/app/kernel/
/app/deepeval/
/app/phoenix/
/app/datasets/
/app/metrics/
/app/runners/
/app/config.py
/app/contracts/

# Copied test subset + the phoenix_integration auto-skip conftest
/tests/kernel/
/tests/service/
/tests/conftest.py

# Resolved venv built by `uv sync --frozen` during the rehearsal
/.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/
