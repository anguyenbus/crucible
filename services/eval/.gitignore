# services/eval is the single source of truth for the eval service. app/ is the
# deliverable that migrates 1:1 to genai-backend/services/eval/app/; dev/ is the
# local-only zone (never migrates). Both are tracked. Only build artifacts and
# caches are ignored.

# Resolved venv built by `uv sync`.
/.venv/

# Local-only fixture data (large ChromaDB index + corpora) lives under
# dev/fixtures/ and is not tracked.
/dev/fixtures/data/

# Build outputs.
/dist/
/build/
*.egg-info/

# Python + tooling caches.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
